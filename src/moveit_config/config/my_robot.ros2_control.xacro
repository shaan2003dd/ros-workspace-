<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="my_robot_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <!-- By default, set up controllers for simulation. This won't work on real hardware -->
                <plugin>mock_components/GenericSystem</plugin>
            </hardware>
            <joint name="base_link_Slider-13">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['base_link_Slider-13']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="link_1_Revolute-14">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['link_1_Revolute-14']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="link_2_Revolute-15">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['link_2_Revolute-15']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="link_3_Revolute-16">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['link_3_Revolute-16']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="MOTOR_Revolute-17">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['MOTOR_Revolute-17']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
