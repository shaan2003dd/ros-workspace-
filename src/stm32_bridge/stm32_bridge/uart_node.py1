#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import JointState
import serial
import math


class JointStateUART(Node):
    def __init__(self):
        super().__init__('jointstate_uart')

        # -------- SERIAL CONFIG --------
        self.ser = serial.Serial(
            port='/dev/ttyUSB0',
            baudrate=115200,
            timeout=0.1
        )

        if self.ser.is_open:
            self.get_logger().info('UART connected')

        # -------- ROS SUBSCRIBER --------
        self.sub = self.create_subscription(
            JointState,
            '/joint_states',
            self.joint_cb,
            10
        )

        # expected joint order
        self.joint_order = [
            'base_link_Slider',
            'link_1',
            'link_2',
            'link_3'
        ]

    def joint_cb(self, msg: JointState):
        joint_map = dict(zip(msg.name, msg.position))
        values = []

        for joint in self.joint_order:
            for name, pos in joint_map.items():
                if joint in name:

                    # prismatic → send raw value
                    if "Slider" in name or "Prismatic" in name:
                        values.append(f"{pos:.3f}")

                    # revolute → radians → degrees (0–360)
                    else:
                        deg = (pos * 180.0 / math.pi) % 360.0
                        values.append(f"{deg:.2f}")

                    break

        payload = ",".join(values) + "\n"

        self.ser.write(payload.encode('utf-8'))
        self.get_logger().info(payload.strip())


def main():
    rclpy.init()
    node = JointStateUART()
    rclpy.spin(node)
    node.ser.close()
    node.destroy_node()
    rclpy.shutdown()


if __name__ == '__main__':
    main()

